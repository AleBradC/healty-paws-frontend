# =====================================================================
# Healthy Paws — Frontend environment template
# =====================================================================
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# NEVER put secrets in here — anything in this file is shipped to the client.

# Base URL of the backend API. Leave empty to use the current origin (the
# default when behind the wrapper's nginx gateway on http://localhost).
# Set when running the frontend dev server against a remote backend.
VITE_API_BASE_URL=
