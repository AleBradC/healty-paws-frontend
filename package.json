{
  "name": "healty-paws-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "analyze": "ANALYZE=1 vite build && echo 'Open dist/bundle-report.html'",
    "generate": "graphql-codegen",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@apollo/client": "^4.0.9",
    "@hookform/resolvers": "5.2.2",
    "@sentry/react": "10.53.1",
    "axios": "^1.13.2",
    "date-fns": "^4.1.0",
    "graphql": "^16.12.0",
    "react": "^19.2.0",
    "react-day-picker": "^9.11.3",
    "react-dom": "^19.2.0",
    "react-hook-form": "7.76.0",
    "react-router-dom": "^7.9.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@graphql-codegen/cli": "^6.2.1",
    "@graphql-codegen/client-preset": "^5.2.4",
    "@graphql-codegen/typescript": "^5.0.9",
